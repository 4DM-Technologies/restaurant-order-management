{
  "headers": [
    {
      "source": "**/*.{js,css,woff,woff2,ttf,otf,ico,eot,svg,png,jpg,jpeg,gif,webp,avif}",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "**",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}