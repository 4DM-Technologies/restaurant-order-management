# ============================================================
# FRONTEND .env.example — Soroco House (React/Vite) — dev values
# Copy to `.env.development` locally (never commit .env files):
#   Windows: copy .env.example .env.development
#   Linux/mac: cp .env.example .env.development
# Vite only exposes VITE_* keys to the browser.
# ============================================================

# Brand name shown in UI
VITE_APP_NAME=restaurant-order-management

# REST API base. ALREADY contains /api/v1 (backend router prefix),
# so code only writes short paths like /menu, /uploads, /payment.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# WebSocket base (same backend). Connect e.g. ws://localhost:8000/api/v1/ws/menu
VITE_WS_BASE_URL=ws://localhost:8000/api/v1

# Image origin — the helper joins VITE_IMAGE_BASE_URL + relative image_url.
# Backend serves uploads at /images/... so dev base is the backend ORIGIN (no trailing slash).
# Prod: set to your S3/CloudFront origin (e.g. https://dxxxx.cloudfront.net), or "" when a
# reverse proxy serves /images same-origin. Absolute image_url (http/https) is ALWAYS used as-is.
VITE_IMAGE_BASE_URL=http://localhost:8000

# Login-screen hint credentials. Keep in sync with backend/seed_data/accounts.json
# (admin has a password; the employee account is activated via the Sign up flow).
VITE_ADMIN_EMAIL=thameem@test.com
VITE_ADMIN_PASSWORD=admin123
VITE_EMPLOYEE_EMAIL=employee@test.com