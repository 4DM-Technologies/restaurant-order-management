# Backend environment — copy to .env and fill in real values (never commit .env)

# App
DEV_APP_NAME=restaurant-order-management
DEV_HOST=0.0.0.0
DEV_PORT=8000

# Database (RDS Postgres with SSL)
DEV_DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# Local fallback: sqlite:///./data/restaurant.db

# Auth (HS256)
DEV_JWT_SECRET_KEY=change-me-strong-secret
DEV_JWT_EXPIRE_MINUTES=480
DEV_AUTH_RATE_LIMIT=5/minute

# CORS (comma separated)
DEV_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Payments (mock | phonepay | razorpay)
DEV_PAYMENT_PROVIDER=mock
DEV_PHONEPAY_MERCHANT_ID=MERCHANTUAT
DEV_PHONEPAY_BASE_URL=https://api-preprod.phonepe.com/apis/pg-sandbox
DEV_PHONEPAY_SALT_KEY=
DEV_PHONEPAY_SALT_INDEX=1
DEV_RAZORPAY_KEY_ID=rzp_test_xxxx
DEV_RAZORPAY_KEY_SECRET=

# Bill email (false -> real SMTP via Gmail App Password)
DEV_EMAIL_MOCK=true
DEV_SMTP_HOST=smtp.gmail.com
DEV_SMTP_PORT=587
DEV_SMTP_USER=you@gmail.com
DEV_SMTP_PASSWORD=app-password
DEV_SMTP_SENDER=you@gmail.com

# Image storage (local | s3)
DEV_STORAGE_DRIVER=local
DEV_UPLOAD_DIR=./uploads
DEV_UPLOAD_MAX_SIZE_MB=5
DEV_UPLOAD_ALLOWED_TYPES=jpeg,png,webp

# S3 driver (only when DEV_STORAGE_DRIVER=s3)
# Credentials come from the AWS default credential chain — do NOT set them here:
#   - EC2 deployment: IAM instance role (no keys required)
#   - Local: AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY in this .env (load_dotenv
#     picks them up) or in ~/.aws/credentials
AWS_REGION=ap-south-1
DEV_S3_BUCKET=soroco-food-images
DEV_S3_CDN_URL=