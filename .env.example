# Root .env for `docker compose` (dev only).
# Copy to .env, fill real values, NEVER commit .env.
# Every key below is optional — compose provides safe dev defaults.

# App
DEV_APP_NAME=restaurant-order-management

# Backend (sandbox-only, DEV_ prefix)
DEV_JWT_SECRET_KEY=change-me-local-secret
DEV_JWT_EXPIRE_MINUTES=480
DEV_CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173

# Payment (sandbox test keys)
DEV_PAYMENT_PROVIDER=razorpay
DEV_RAZORPAY_KEY_ID=rzp_test_xxxx
DEV_RAZORPAY_KEY_SECRET=change-me

# Bill delivery — 100% free SMTP (Gmail App Password). Emails really send in dev;
# set DEV_EMAIL_MOCK=true only if you want to print to console instead.
DEV_EMAIL_MOCK=false
DEV_SMTP_HOST=smtp.gmail.com
DEV_SMTP_PORT=587
DEV_SMTP_USER=
DEV_SMTP_PASSWORD=
DEV_SMTP_SENDER=

# DB: local SQLite dev DB (AWS RDS PostgreSQL optional — RDS-SETUP-GUIDE.md at repo root)
DEV_DATABASE_URL=sqlite:///./data/restaurant.db
DEV_AUTH_RATE_LIMIT=5/min

# Food image storage (uploaded via POST /api/v1/uploads).
# driver=local → files written to DEV_UPLOAD_DIR and served by FastAPI (offline dev).
# driver=s3    → files stored in DEV_S3_BUCKET; see S3-SETUP-GUIDE.md at repo root.
# Run `copy .env.example .env` (Windows) / `cp .env.example .env` and fill real values.
DEV_STORAGE_DRIVER=local
DEV_UPLOAD_DIR=./uploads
DEV_UPLOAD_MAX_SIZE_MB=5
DEV_UPLOAD_ALLOWED_TYPES=jpeg,png,webp
DEV_S3_BUCKET=soroco-food-images
DEV_S3_REGION=ap-south-1
DEV_S3_ACCESS_KEY_ID=
DEV_S3_SECRET_ACCESS_KEY=
# CloudFront distribution origin (recommended). Empty → plain S3 object URL returned.
DEV_S3_CDN_URL=